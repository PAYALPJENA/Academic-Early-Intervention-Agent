# Python environments and caches
.venv/
.venv*/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.streamlit/cache/

# Node dependencies
**/node_modules/

# Local secrets and environment files
.env
.env.*
!.env.example
.streamlit/secrets.toml
*.pem
*.key
id_rsa
id_ed25519
*.p12
*.pfx

# Temporary and office files
